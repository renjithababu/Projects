{
  "manifest_version": 3,
  "name": "The Instigator Clipboard Manager",
  "version": "1.0.0",
  "description": "Dynamic time-scaling clipboard manipulation with ragebait payloads and memory loss degradation.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "The Instigator",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "src/assets/icon-16.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  }
}
